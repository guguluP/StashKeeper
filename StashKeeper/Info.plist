<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSCameraUsageDescription</key>
	<string>StashKeeper can use the camera to photograph items you want to catalog.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>StashKeeper needs photo access so you can catalog items from pictures of your shelves, fridge, or packaging.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>StashKeeper may read limited activity and dietary summary data to personalize recipe suggestions. It does not sell or share this data.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>StashKeeper can log nutrition facts for food items you choose to send to Apple Health.</string>
</dict>
</plist>
